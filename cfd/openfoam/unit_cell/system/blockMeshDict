/*--------------------------------*- C++ -*----------------------------------*\
  OpenFOAM v13. Quarter unit cell of an infinite square rod array, P/D=1.107.

  The rod (radius r=0.07 m) sits at the origin; the cell spans 0<=x,y<=a
  (a = P/2 = 0.0775 m). Two blocks split by the 45-degree diagonal form an
  O-grid around the rod:
    block A: 0-45 deg  (narrow gap at 0 deg, i.e. between (r,0) and (a,0))
    block B: 45-90 deg (narrow gap at 90 deg)
  The subchannel centre is the corner (a,a). This is the same "effective
  unit cell" the 2023 DNS paper averages its statistics over.

  Streamwise direction is z: one cell thick, cyclic front/back, driven by
  meanVelocityForce (system/fvConstraints).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

scale   1;

r       0.07;
a       0.0775;
c       0.0494974747;   // r/sqrt(2)
Lz      0.001;

nRadial 60;
nAzim   40;             // per 45-degree block
gRadial 8;              // last/first radial cell size (clusters cells at the rod)

vertices
(
    ($r  0   0)     // 0  rod, 0 deg
    ($a  0   0)     // 1  gap centre
    ($a  $a  0)     // 2  subchannel centre
    ($c  $c  0)     // 3  rod, 45 deg
    (0   $a  0)     // 4  gap centre (90 deg)
    (0   $r  0)     // 5  rod, 90 deg

    ($r  0   $Lz)   // 6
    ($a  0   $Lz)   // 7
    ($a  $a  $Lz)   // 8
    ($c  $c  $Lz)   // 9
    (0   $a  $Lz)   // 10
    (0   $r  $Lz)   // 11
);

blocks
(
    hex (0 1 2 3 6 7 8 9)    ($nRadial $nAzim 1) simpleGrading ($gRadial 1 1)
    hex (3 2 4 5 9 8 10 11)  ($nRadial $nAzim 1) simpleGrading ($gRadial 1 1)
);

edges
(
    arc 0 3   (0.0646716 0.0267878 0)
    arc 3 5   (0.0267878 0.0646716 0)
    arc 6 9   (0.0646716 0.0267878 $Lz)
    arc 9 11  (0.0267878 0.0646716 $Lz)
);

boundary
(
    rod
    {
        type wall;
        faces
        (
            (0 6 9 3)
            (3 9 11 5)
        );
    }

    symY0       // y = 0 plane, rod -> gap centre
    {
        type symmetryPlane;
        faces ((0 1 7 6));
    }

    symXa       // x = a plane, gap centre -> subchannel centre
    {
        type symmetryPlane;
        faces ((1 2 8 7));
    }

    symYa       // y = a plane
    {
        type symmetryPlane;
        faces ((2 4 10 8));
    }

    symX0       // x = 0 plane
    {
        type symmetryPlane;
        faces ((5 11 10 4));
    }

    front
    {
        type cyclic;
        neighbourPatch back;
        faces
        (
            (0 3 2 1)
            (3 5 4 2)
        );
    }

    back
    {
        type cyclic;
        neighbourPatch front;
        faces
        (
            (6 7 8 9)
            (9 8 10 11)
        );
    }
);

