/*--------------------------------*- C++ -*----------------------------------*\
  2023 DNS normalisation: U_b = 1 m/s, rho = 1, so Re_h = U_b*Dh/nu fixes nu.
  Quarter unit cell hydraulic diameter (4*flow area / wetted perimeter):
      Dh = 4*(a^2 - pi*r^2/4)/(pi*r/2) = 0.078497 m
  Re_h = 9800  ->  nu = Dh/Re_h = 8.0099e-06 m^2/s
  To run another Reynolds number, change nu only (U_b stays 1).
\*---------------------------------------------------------------------------*/
FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}

viscosityModel  constant;

nu              8.0099e-06;

